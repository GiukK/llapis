# --- model weights ---------------------------------------------------------
# Never versioned. The layout under models/ is tracked (via .gitkeep); the weights
# are downloaded by the user (see README) and the derived artifacts are rebuilt by
# `moert-server prepare`.
*.gguf
*.experts.pack
*.experts.index
# Layout variants of the same pack (e.g. .expert-major), side by side for A/B runs.
*.experts.pack.*
*.experts.index.*
# Predictor / forecaster weights (MOE_DUAL_MTP_NN, MOE_DUAL_STEP_NN, ...): trained per model, never versioned.
models/forecast/
# Backups of a model file kept while a rebuilt one is checked (e.g. a draft head before `prepare` replaced it).
models/**/*.bak-*

# --- the OLD bootstrap checkout ---------------------------------------------
# Up to 2026-08-10, scripts/bootstrap.ps1 cloned the pinned llama.cpp here and
# applied the LLapis patch to it. That is gone: the source now lives in
# third_party/llama, in this repository (see third_party/llama/PROVENANCE.md).
# The rule stays only so an old working copy's leftover clone -- 47k files, most
# of it tools/ui/node_modules -- does not appear as untracked. Nothing reads it;
# it is safe to delete.
external/

# --- build trees and compiled artifacts ------------------------------------
build/
build-*/
# Generated at CONFIGURE time by third_party/llama/scripts/ui-assets.cmake, which
# gzips every UI asset into a parallel tree INSIDE the source directory. Derived
# from the 134 files next to it, so it is regenerated, never committed.
third_party/llama/tools/ui/dist/_gzip/
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp

# --- per-machine state ------------------------------------------------------
# Written by `llapis setup`; holds this machine's runtime choice. Regenerated by
# re-running the wizard.
llapis-user.json
logs/
# Written by the runtime at every turn end: which experts this machine was routing
# to when it last ran, so the next launch starts warm. Per-machine and per-workload
# by nature; deleting it costs one cold session.
models/cache/residency-*.bin
# The installed models' VRAM terms (setup.ps1, Get-LlapisModelTerms), cached per file identity; rebuilt on demand.
models/cache/fit-terms-*.json

# --- OS / editor cruft ------------------------------------------------------
Thumbs.db
Desktop.ini
.vs/
.vscode/
.idea/
__pycache__/
*.pyc
